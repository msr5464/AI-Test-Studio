# Flask & Server
# ==============
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HOST=localhost
PORT=5001

# Company name used in AI-generated test prompts (also configurable in Admin → Settings → LLM)
COMPANY_NAME=YourCompany

# Storage Paths
# =============
# Use forward slashes for cross-platform compatibility
STORAGE_DIR=storage
DOCUMENTS_DIR=storage/documents
CHROMA_DB_DIR=storage/chroma_db
EMBEDDING_CACHE_DIR=storage/embedding_cache

# RAG Base (ChromaDB, chunking)
# =============================
COLLECTION_NAME=rag_collection
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Chat Retrieval (CHAT_* prefix)
# ==============================
# Number of document chunks to retrieve per query
CHAT_RETRIEVAL_K=6
# Minimum similarity % (0-100) to include a source
CHAT_MIN_SIMILARITY_THRESHOLD=55.0
# Hybrid search (semantic + BM25), reranking, query expansion
CHAT_USE_HYBRID_SEARCH=True
CHAT_USE_RERANKING=True
CHAT_USE_QUERY_EXPANSION=False

# Chat Display & Caching
# ======================
# Show matching sources after each query
SHOW_MATCHING_SOURCES=False
# Query result cache
ENABLE_QUERY_CACHE=True
QUERY_CACHE_SIZE=1000
# Embedding cache
ENABLE_EMBEDDING_CACHE=True

# LLM Configuration
# =================
LLM_PROVIDER=ollama

# Option 1: OpenAI
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini
# GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-2.5-flash
# If you hit 429 Resource Exhausted: increase retries and/or add a delay between LLM calls
# GEMINI_MAX_RETRIES=10
# REQUIREMENT_ANALYSIS_LLM_DELAY_SEC=1

# Option 3: Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Admin
# =====
ADMIN_UPLOAD_MAX_SIZE_MB=50

# TestRail (sync + requirement-analysis push)
# ===========================================
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_EMAIL=your-email@company.com
TESTRAIL_API_KEY=your-api-key
TESTRAIL_PROJECT_IDS=1,2,3
TESTRAIL_DELTA_DAYS=0
TESTRAIL_PUSH_ENABLED=false
TESTRAIL_SCHEDULE_ENABLED=False
TESTRAIL_SCHEDULE_TIME=02:00

# Confluence (sync + requirement spec via URL)
# ============================================
# CQL: Confluence Query Language; if empty, defaults to type=page.
# Example: CONFLUENCE_CQL=type=page AND space=Product AND ancestor=1170342064
CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your-atlassian-api-token
CONFLUENCE_CQL=type=page
CONFLUENCE_DELTA_DAYS=0

# Requirement Analysis (REQUIREMENT_* prefix)
# ===========================================
# Retrieval: find_related_tests (TestRail)
REQUIREMENT_TESTS_SIMILARITY_THRESHOLD=60.0
# Retrieval: find_related_specs (Confluence). Lower than test threshold — spec pages use broad business language.
REQUIREMENT_SPECS_SIMILARITY_THRESHOLD=50.0
# Max number of related tests to return. Always the TOP K by similarity (best first), not random.
REQUIREMENT_RETRIEVAL_K=10
# Hybrid search: combine vector (semantic) + BM25 (keyword) retrieval.
REQUIREMENT_USE_HYBRID_SEARCH=True
# Re-ranking: after retrieval, re-score candidates with a CrossEncoder. Better ordering but slower.
REQUIREMENT_USE_RERANKING=False
# Priority-based rule: don't generate P0 if we have at least this many P0 related tests (same for P1, P2, P3)
REQUIREMENT_MIN_TESTS_PER_PRIORITY=3
# Only related tests with similarity >= this (0-100) count toward the per-priority cap above.
REQUIREMENT_TESTS_COVERAGE_MIN_SIMILARITY=70
# Enrich requirement titles with document context using LLM (extra LLM call but makes requirements self-contained)
REQUIREMENT_ENRICH_WITH_CONTEXT=true
# Process requirements in parallel (faster) or sequentially (easier to debug)
REQUIREMENT_PARALLEL_PROCESSING=true

# Cost Tracking (optional)
# ========================
# OPERATION_COSTS_FILE=storage/operation_costs.jsonl
# LLM_COST_INPUT_PER_1M=2.5
# LLM_COST_OUTPUT_PER_1M=10.0
