# config/env.example — every AI-Test-Studio setting. Copy to config/.env.
# Admin → Studio Settings edits many of these at runtime and writes them back
# into config/.env.

# Flask & Server
# ==============
FLASK_DEBUG=False
# REQUIRED. The app refuses to start with this placeholder (or an empty value)
# unless FLASK_DEBUG=true. See the Security section below.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here-change-in-production
# HOST is used by the development server only (backend/app.py, default 0.0.0.0);
# gunicorn always binds 0.0.0.0:$PORT.
HOST=localhost
PORT=5001

# Company name used in AI-generated test prompts (also configurable in Admin → Settings → LLM)
COMPANY_NAME=YourCompany

# Storage Paths
# =============
# Use forward slashes for cross-platform compatibility
STORAGE_DIR=storage
DOCUMENTS_DIR=storage/documents
CHROMA_DB_DIR=storage/chroma_db
EMBEDDING_CACHE_DIR=storage/embedding_cache

# RAG Base (ChromaDB, chunking)
# =============================
COLLECTION_NAME=rag_collection
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Chat Retrieval (CHAT_* prefix)
# ==============================
# Number of document chunks to retrieve per query
CHAT_RETRIEVAL_K=10
# Minimum similarity % (0-100) to include a source
CHAT_MIN_SIMILARITY_THRESHOLD=55.0
# Hybrid search (semantic + BM25), reranking, query expansion
CHAT_USE_HYBRID_SEARCH=True
CHAT_USE_RERANKING=True
CHAT_USE_QUERY_EXPANSION=False

# Chat Display & Caching
# ======================
# Show matching sources after each query
SHOW_MATCHING_SOURCES=False
# Query result cache
ENABLE_QUERY_CACHE=True
QUERY_CACHE_SIZE=1000
# Embedding cache
ENABLE_EMBEDDING_CACHE=True

# LLM Configuration
# =================
LLM_PROVIDER=ollama

# Option 1: OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini (GEMINI_API_KEY is accepted as an alias)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=10
REQUIREMENT_ANALYSIS_LLM_DELAY_SEC=1

# Option 3: Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Admin
# =====
ADMIN_UPLOAD_MAX_SIZE_MB=50

# TestRail (sync + requirement-analysis push)
# ===========================================
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_EMAIL=your-email@company.com
TESTRAIL_API_KEY=your-api-key
TESTRAIL_PROJECT_IDS=1,2,3
TESTRAIL_DELTA_DAYS=0
TESTRAIL_PUSH_ENABLED=false
# Daily auto-sync; the time is UTC (24-hour)
TESTRAIL_SCHEDULE_ENABLED=False
TESTRAIL_SCHEDULE_TIME=02:00

# Confluence (sync + requirement spec via URL)
# ============================================
# CQL: Confluence Query Language; if empty, defaults to type=page.
# Example: CONFLUENCE_CQL=type=page AND space=Product AND ancestor=1170342064
CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your-atlassian-api-token
CONFLUENCE_CQL=type=page
CONFLUENCE_DELTA_DAYS=0
# Daily auto-sync; the time is UTC (24-hour)
# CONFLUENCE_SCHEDULE_ENABLED=False
# CONFLUENCE_SCHEDULE_TIME=03:00

# Requirement Analysis (REQUIREMENT_* prefix)
# ===========================================
# Retrieval: find_related_tests (TestRail)
REQUIREMENT_TESTS_SIMILARITY_THRESHOLD=60.0
# Retrieval: find_related_specs (Confluence). Lower than test threshold — spec pages use broad business language.
REQUIREMENT_SPECS_SIMILARITY_THRESHOLD=50.0
# Max number of related tests to return. Always the TOP K by similarity (best first), not random.
REQUIREMENT_RETRIEVAL_K=10
# Hybrid search: combine vector (semantic) + BM25 (keyword) retrieval.
REQUIREMENT_USE_HYBRID_SEARCH=True
# Re-ranking: after retrieval, re-score candidates with a CrossEncoder. Better ordering but slower.
REQUIREMENT_USE_RERANKING=False
# Priority-based rule: don't generate P0 if we have at least this many P0 related tests (same for P1, P2, P3)
REQUIREMENT_MIN_TESTS_PER_PRIORITY=3
# Only related tests with similarity >= this (0-100) count toward the per-priority cap above.
REQUIREMENT_TESTS_COVERAGE_MIN_SIMILARITY=70
# Enrich requirement titles with document context using LLM (extra LLM call but makes requirements self-contained)
REQUIREMENT_ENRICH_WITH_CONTEXT=true
# Process requirements in parallel (faster) or sequentially (easier to debug)
REQUIREMENT_PARALLEL_PROCESSING=true
# REQUIREMENT_PARALLEL_WORKERS=8
# Enough related tests (at REQUIREMENT_TESTS_COVERAGE_MIN_SIMILARITY) to call a requirement covered
# REQUIREMENT_COVERAGE_SUFFICIENT_MIN_TESTS=5
# Where background runs (Live Run / History) are stored
# REQUIREMENT_SESSIONS_DIR=storage/requirement_sessions
# REQUIREMENT_RUNS_FILE=storage/requirement_runs.jsonl

# Cost Tracking (always on; feeds Admin → Analytics)
# ==================================================
# OPERATION_COSTS_FILE=storage/operation_costs.jsonl
# Per-model USD per 1M tokens, overriding the built-in rate card (backend/cost_tracker.py):
# LLM_COST_RATES_JSON={"gpt-4o-mini": [0.15, 0.60]}
# Fallback for models not on the rate card:
# LLM_COST_INPUT_PER_1M=2.5
# LLM_COST_OUTPUT_PER_1M=10.0

# Analytics (also editable in Admin → Studio Settings)
# ====================================================
# Human-minutes baselines used to estimate time saved
# ANALYTICS_MIN_PER_TEST_AUTHORED=240
# ANALYTICS_MIN_PER_TEST_FIXED=60
# ANALYTICS_MIN_PER_TEST_ADAPTED=150
# ANALYTICS_MIN_PER_TEST_CASE_WRITTEN=15
# ANALYTICS_DEFAULT_WINDOW=7d

# Appearance
# ==========
# Theme for first-time visitors: dark | light
# DEFAULT_THEME=dark

# QA Agent Network (optional)
# ===========================
# URL of the QA-Agent-Network HTTP server (a sibling repo). Start it there with
# `bash scripts/run-server.sh`. The agent pages (Automation Code, Auto-Heal,
# Adapt) and Admin → Agent Settings / Analytics reach it through this URL. The
# default is used when unset; when nothing is listening, those pages show as
# offline and the rest of the app works normally.
# QA_AGENT_NETWORK_URL=http://localhost:6001
# QA_AGENT_NETWORK_TIMEOUT=30

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED. The app refuses to start with a placeholder unless FLASK_DEBUG=true.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# This signs the session cookie, which is the only thing separating a visitor
# from an admin — a known value lets anyone mint an admin session.
# (SECRET_KEY is set at the top of this file.)

# Comma-separated origins allowed to make credentialed cross-origin requests.
# Defaults to localhost only. Never set this to * — credentials are enabled, so
# Flask-CORS would reflect any caller's Origin back and there is no CSRF token.
# CORS_ALLOWED_ORIGINS=https://studio.example.com

# Set true when serving over HTTPS so the session cookie is not sent in clear.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax

# Shared secret proving proxied requests came from this app rather than straight
# off the network. Must match QA_AGENT_PROXY_SECRET in QA-Agent-Network's
# config/.env. Without it, qa_agents_server can only rely on binding to
# localhost, since it trusts the X-User-* headers this proxy injects.
# QA_AGENT_PROXY_SECRET=

# Production server (gunicorn_config.py; used by scripts/run-production.sh)
# ========================================================================
# GUNICORN_THREADS=32
# GUNICORN_TIMEOUT=900
# GUNICORN_LOG_LEVEL=info
# GUNICORN_ACCESS_LOG=-
# GUNICORN_ERROR_LOG=-
# GUNICORN_PIDFILE=
